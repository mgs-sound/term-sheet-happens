{
  "name": "term-sheet-happens",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:phone": "npm run build && vite preview --host 0.0.0.0",
    "dev:api": "node --experimental-strip-types --no-warnings scripts/leaderboard-dev.ts",
    "tunnel": "node scripts/tunnel.mjs",
    "deploy": "npx vercel --prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-content": "node --experimental-strip-types --no-warnings scripts/validate-content.ts",
    "apply-review": "node --experimental-strip-types --no-warnings scripts/apply-review.ts",
    "simulate": "node --experimental-strip-types --no-warnings scripts/simulate.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^5.9.6",
    "@vitejs/plugin-react": "^4.5.0",
    "localtunnel": "^2.0.2",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
