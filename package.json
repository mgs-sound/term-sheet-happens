{
  "name": "term-sheet-happens",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "desktop/build/main.js",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:phone": "npm run build && vite preview --host 0.0.0.0",
    "tunnel": "node scripts/tunnel.mjs",
    "deploy": "npx vercel --prod",
    "screenshots": "node scripts/screenshots.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios": "npm run ios:sync && cap open ios",
    "desktop:build": "tsc -p desktop",
    "desktop:dev": "node desktop/steam-sdk.mjs --verify && npm run desktop:build && node desktop/dev.mjs",
    "desktop:dev:nosteam": "npm run desktop:build && TSH_NO_STEAM=1 node desktop/dev.mjs",
    "desktop": "node desktop/steam-sdk.mjs --verify && npm run build && npm run desktop:build && steamworks-fetch-universal-koffi && electron-builder --mac",
    "desktop:local": "npm run build && npm run desktop:build && electron-builder --mac -c electron-builder.local.yml",
    "steam:sdk": "node desktop/steam-sdk.mjs",
    "steam:upload": "steamcmd +login \"$STEAM_USER\" +run_app_build \"$PWD/desktop/steam/app_build.vdf\" +quit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-content": "node --experimental-strip-types --no-warnings scripts/validate-content.ts",
    "simulate": "node --experimental-strip-types --no-warnings scripts/simulate.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "steamworks-ffi-node": "^0.11.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.1.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "localtunnel": "^2.0.2",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
